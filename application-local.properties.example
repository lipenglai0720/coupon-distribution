# 复制到项目根目录的 application-local.properties，填写本地配置。
spring.profiles.active=sharded
server.port=8080
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/quanshu?serverTimezone=UTC
spring.datasource.username=coupon_app
spring.datasource.password=REPLACE_WITH_DATABASE_PASSWORD
spring.data.redis.host=127.0.0.1
spring.data.redis.port=6379
quanshu.redis-enabled=true
quanshu.mq-enabled=true
spring.rabbitmq.host=127.0.0.1
spring.rabbitmq.port=5672
spring.rabbitmq.username=coupon_app
spring.rabbitmq.password=REPLACE_WITH_RABBITMQ_PASSWORD
spring.rabbitmq.virtual-host=quanshu
quanshu.accounts-file=accounts.json
